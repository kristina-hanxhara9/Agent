# GitHub Authentication (for Copilot agent dispatch)
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Concurrency Controls
MAX_CONCURRENT_AGENTS=5
AGENT_TIMEOUT_MS=120000
SCRAPER_TIMEOUT_MS=30000

# Output Configuration
OUTPUT_DIR=./data/output
LOG_DIR=./data/logs
LOG_LEVEL=info

# Scraper Configuration
USER_AGENT=Mozilla/5.0 (compatible; RetailerDataBot/1.0; +https://github.com/your-org/agent)
RESPECT_ROBOTS_TXT=true
MAX_REQUESTS_PER_DOMAIN_PER_MIN=10

# Playwright Configuration
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_VIEWPORT_WIDTH=1920
PLAYWRIGHT_VIEWPORT_HEIGHT=1080

# Validation
STRICT_VALIDATION=true
REQUIRE_SOURCE_URLS=true
MIN_CONFIDENCE_THRESHOLD=0.6

# MCP Server (when running locally for VS Code)
MCP_SERVER_PORT=3845
